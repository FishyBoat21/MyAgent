{
    "name": "fishyboat21/myagent",
    "description": "A lightweight PHP CLI coding agent with local tools, Agent Skills, stdio MCP, and an independent security reviewer.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "MyAgent\\": "src/"
        },
        "classmap": [
            "src/"
        ]
    },
    "scripts": {
        "test": "@php tests/smoke.php && @php tests/media.php && @php tests/bridge.php",
        "test:media": "@php tests/media.php",
        "test:bridge": "@php tests/bridge.php",
        "test:ui": "@php tests/ui.php",
        "test:selector": "@php tests/selector.php",
        "test:cancel": "@php tests/cancellation.php",
        "demo": "@php tests/render-demo.php --force --color=always --width=100"
    },
    "suggest": {
        "ext-gd": "Needed to downscale images before they are sent to the model"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
